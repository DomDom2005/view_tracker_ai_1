# Szablon konfiguracji — same nazwy zmiennych, żadnych wartości (SPEC §13).
# Skopiuj do .env (poza repo, wpisany w .gitignore) i uzupełnij lokalnie.

# --- Allegro OAuth (wymagane do logowania i zbierania danych) ---
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# sandbox | prod (puste = sandbox)
ALLEGRO_ENV=
# Nagłówek User-Agent wymagany przez API (SPEC §4.1): NazwaAplikacji/Wersja (+URL)
# Puste = wartość domyślna view_tracker_ai_1/2.0.1 (+https://github.com/DomDom2005/view_tracker_ai_1)
ALLEGRO_USER_AGENT=

# --- Ścieżki (opcjonalne; puste = wartości domyślne) ---
# Domyślnie ~/.config/view_tracker_ai_1/tokens.json
TOKEN_STORE_PATH=
# Domyślnie data/sandbox.db
DB_PATH=

# --- Zachowanie aplikacji ---
# 1 = zezwól na zapisy do API w środowisku prod (puste = zabronione)
ALLOW_PROD_WRITES=
# DEBUG | INFO | WARNING | ERROR (puste = INFO)
LOG_LEVEL=
